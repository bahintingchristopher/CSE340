<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <table class="users-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email (Username)</th>
                <th>Role</th>
            </tr>
        </thead>
        <tbody>
            <% if (users && users.length > 0) { %>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.name %></td>
                        <td><%= user.email %></td>
                        <td><%= user.role_name %></td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="3">No registered users found.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
</main>
<%- include('partials/footer') %>