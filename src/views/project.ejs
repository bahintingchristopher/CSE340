<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <section class="project-details">
        <p><strong>Description:</strong> <%= project.description %></p>
        <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString() %></p>
        <p><strong>Location:</strong> <%= project.location %></p>
        <p>
            <strong>Partner Organization:</strong> 
            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
        </p>

        <p class="project-categories">
            <strong>Category:</strong> 
            <% if (categories && categories.length > 0) { %>
                <% categories.forEach((category, index) => { %>
                    <a href="/category/<%= category.category_id %>" class="category-link">
                        <%= category.name %>
                    </a><%= index < categories.length - 1 ? ', ' : '' %>
                <% }); %>
            <% } else { %>
                <span>No categories assigned</span>
            <% } %>
        </p>

        <!-- Start week6 final assignment -->
        <!-- VOLUNTEER SECTION -->
        <% if (typeof user !== 'undefined' && user && user.role_name !== 'admin') { %>
            <div class="volunteer-box">
                <% if (isVolunteering) { %>
                    <p class="volunteer-status-msg">You are volunteering for this project!</p>
                    <form action="/remove-volunteer/<%= project.project_id %>" method="POST">
                    <button type="submit" class="btn btn-unvolunteer">Remove Volunteering</button>
                    </form>
                <% } else { %>
                   <form action="/add-volunteer/<%= project.project_id %>" method="POST">
                    <button type="submit" class="btn btn-volunteer">Volunteer for this Project</button>
                    </form>
                <% } %>
            </div>
        <% } %>
        <!-- end week6 final assignment -->


        <!-- week4 edit categories  -->
        <% if (user && user.role_name === 'admin') { %> 
        <a href="/assign-categories/<%= project.project_id %>">Edit Categories</a>
        <% } %>
    </section>
</main>
<%- include('partials/footer') %>