<%- include('partials/header') %>

<link rel="stylesheet" href="/css/main.css">

<main>
    <h1><%= title %></h1> 
    <table class="projects-items">
        <thead>
            <tr>
                <th>Date</th>
                <th>Project Title</th>
                <th>Organization Name</th>
                <% if (user && user.role_name === 'admin') { %>
                    <th>Action</th>
                <% } %>
            </tr>
        </thead>
        <tbody>
            <% projects.forEach(project => { %>
                <% 
                    const rawDate = project.date || project.project_date;
                    const datesetup = { year: 'numeric', month: 'long', day: 'numeric' };
                    const formattedDate = rawDate ? new Date(rawDate).toLocaleDateString('en-US', datesetup) : 'TBD';
                %>
                <tr>
                    <td><strong><%= formattedDate %></strong></td>
                    
                    <td>
                        <a href="/project/<%= project.project_id %>" class="project-title-link">
                            <%= project.title %>
                        </a>

                        <% if (project.categories && project.categories.length > 0) { %>
                            <div class="table-project-tags">
                                <% project.categories.forEach(cat => { %>
                                    <a href="/category/<%= cat.category_id %>" class="table-tag">
                                        <%= cat.name %>
                                    </a>
                                <% }); %>
                            </div>
                        <% } %>
                    </td>
                    
                    <td>
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </td>

                    <!-- Action column (Admin only) -->
                    <% if (user && user.role_name === 'admin') { %>
                        <td>
                            <a href="/edit-project/<%= project.project_id %>" class="btn btn-secondary">Edit</a>
                        </td>
                    <% } %>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <% if (user && user.role_name === 'admin') { %>
        <p><a href="/new-project">Add a New Service Project</a></p>
    <% } %>
</main>

<%- include('partials/footer') %>